generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id             Int             @id @default(autoincrement())
  nome           String          @unique
  projetos       Projeto[]
  movimentacoes  Movimentacao[]
  agendaItens    Agenda[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ContaBancaria {
  id                   Int             @id @default(autoincrement())
  nome                 String
  banco                String
  observacoes          String?
  saldoAtual           Decimal         @default(0) @map("saldo_atual") @db.Decimal(14, 2)
  movimentacoesOrigem  Movimentacao[]  @relation("ContaOrigem")
  movimentacoesDestino Movimentacao[]  @relation("ContaDestino")
  usuariosContaPrimaria Usuario[]      @relation("UsuarioContaPrimaria")
  usuariosContaAcesso  UsuarioContaAcesso[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([nome, banco])
  @@map("contas_bancarias")
}

model Projeto {
  id            Int            @id @default(autoincrement())
  nome          String
  empresaId     Int            @map("empresa_id")
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  movimentacoes Movimentacao[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([nome, empresaId])
  @@map("projetos")
}

model Movimentacao {
  id            Int                    @id @default(autoincrement())
  data          DateTime
  valor         Decimal                @db.Decimal(14, 2)
  tipo          MovimentacaoTipo
  categoria     MovimentacaoCategoria?
  tipoDespesa   TipoDespesa?           @map("tipo_despesa")
  canalOrigem   String?                @map("canal_origem")
  centroOperacao String?               @map("centro_operacao")
  referencia    String?
  status        MovimentacaoStatus
  subcategoria  GiraKidsSubcategoria?
  empresaId     Int                    @map("empresa_id")
  projetoId     Int?                   @map("projeto_id")
  saasClienteId Int?                   @map("saas_cliente_id")
  saasLancamentoTipo SaasLancamentoTipo? @map("saas_lancamento_tipo")
  contaOrigemId Int?                   @map("conta_origem_id")
  contaDestinoId Int?                  @map("conta_destino_id")
  empresa       Empresa                @relation(fields: [empresaId], references: [id])
  projeto       Projeto?               @relation(fields: [projetoId], references: [id])
  saasCliente   SaasCliente?           @relation(fields: [saasClienteId], references: [id])
  contaOrigem   ContaBancaria?         @relation("ContaOrigem", fields: [contaOrigemId], references: [id])
  contaDestino  ContaBancaria?         @relation("ContaDestino", fields: [contaDestinoId], references: [id])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([empresaId, status, tipo])
  @@index([data])
  @@index([saasClienteId, saasLancamentoTipo])
  @@map("movimentacoes")
}

model Fornecedor {
  id          Int       @id @default(autoincrement())
  nome        String    @unique
  descricao   String?
  ativo       Boolean   @default(true)
  agendaItens Agenda[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("fornecedores")
}

model Agenda {
  id                    Int              @id @default(autoincrement())
  data                  DateTime
  titulo                String
  descricao             String?
  origem                String?
  origemTipo            AgendaOrigem?    @map("origem_tipo")
  tipoPagamento         AgendaTipoPagamento? @map("tipo_pagamento")
  valor                 Decimal          @db.Decimal(14, 2)
  prioridade            String
  status                AgendaStatus
  tipo                  AgendaTipo
  recurrenteAte         DateTime?        @map("recorrente_ate")
  fornecedorId          Int?             @map("fornecedor_id")
  fornecedor            Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  origemExterna         Boolean          @default(false) @map("origem_externa")
  referenciaExternaId   String?          @map("referencia_externa_id")
  usuarioAprovadorId    Int?             @map("usuario_aprovador_id")
  usuarioCriacaoId      Int?             @map("usuario_criacao_id")
  dataAprovacao         DateTime?        @map("data_aprovacao")
  empresaId             Int              @map("empresa_id")
  empresa               Empresa          @relation(fields: [empresaId], references: [id])
  usuarioAprovador      Usuario?         @relation("AgendaAprovador", fields: [usuarioAprovadorId], references: [id])
  usuarioCriacao        Usuario?         @relation("AgendaCriador", fields: [usuarioCriacaoId], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([data, status, origemExterna])
  @@index([referenciaExternaId])
  @@index([fornecedorId])
  @@map("agenda")
}

model Usuario {
  id                    Int             @id @default(autoincrement())
  nome                  String
  email                 String          @unique
  senhaHash             String          @map("senha_hash")
  perfil                PerfilUsuario   @default(FINANCEIRO)
  tema                  TemaUsuario     @default(LIGHT)
  ativo                 Boolean         @default(true)
  contaBancariaId       Int?            @map("conta_bancaria_id")
  contaBancaria         ContaBancaria?  @relation("UsuarioContaPrimaria", fields: [contaBancariaId], references: [id])
  contasAcesso          UsuarioContaAcesso[]
  ultimoLoginAt         DateTime?       @map("ultimo_login_at")
  agendaAprovadas       Agenda[]        @relation("AgendaAprovador")
  agendaCriadas         Agenda[]        @relation("AgendaCriador")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("usuarios")
}

model UsuarioContaAcesso {
  id             Int           @id @default(autoincrement())
  usuarioId      Int           @map("usuario_id")
  contaBancariaId Int          @map("conta_bancaria_id")
  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contaBancaria  ContaBancaria @relation(fields: [contaBancariaId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([usuarioId, contaBancariaId])
  @@index([contaBancariaId])
  @@map("usuarios_contas_acesso")
}

model SaasCliente {
  id                     Int                 @id @default(autoincrement())
  nomeCliente            String              @map("nome_cliente")
  nomeSistema            String              @map("nome_sistema")
  logoParceiraUrl        String?             @map("logo_parceira_url")
  logoSelfMachineUrl     String?             @map("logo_selfmachine_url")
  vendedor               String
  dataEmissao            DateTime            @map("data_emissao")
  linkSistema            String?             @map("link_sistema")
  adminEmail             String?             @map("admin_email")
  adminSenha             String?             @map("admin_senha")
  valorDesenvolvimento   Decimal?            @map("valor_desenvolvimento") @db.Decimal(14, 2)
  valorMensalidade       Decimal             @map("valor_mensalidade") @db.Decimal(14, 2)
  dataInicioMensalidade  DateTime            @map("data_inicio_mensalidade")
  condicoesPagamento     String?             @map("condicoes_pagamento")
  meioPagamento          String?             @map("meio_pagamento")
  chavePix               String?             @map("chave_pix")
  statusSistema          StatusSistemaSaas   @default(ATIVO) @map("status_sistema")
  statusMensalidade      StatusMensalidade   @default(AGUARDANDO_PAGAMENTO) @map("status_mensalidade")
  ultimaMensalidadePagaEm DateTime?          @map("ultima_mensalidade_paga_em")
  tipoPlano              TipoPlanoSaas       @map("tipo_plano")
  descricao              String?
  prazosDescricao        String?             @map("prazos_descricao")
  ultimoPedidoPagamentoAt DateTime?          @map("ultimo_pedido_pagamento_at")
  custoServidor          Decimal?            @map("custo_servidor") @db.Decimal(14, 2)
  custoBancoDados        Decimal?            @map("custo_banco_dados") @db.Decimal(14, 2)
  custoFrontend          Decimal?            @map("custo_frontend") @db.Decimal(14, 2)
  custoOutros            Decimal?            @map("custo_outros") @db.Decimal(14, 2)
  movimentacoes          Movimentacao[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([statusSistema])
  @@index([statusMensalidade])
  @@index([dataInicioMensalidade])
  @@map("saas_clientes")
}

model CotacaoMoeda {
  moeda        String   @id
  valorEmReais Decimal  @map("valor_em_reais") @db.Decimal(14, 4)
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("cotacoes_moeda")
}

enum MovimentacaoTipo {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  AJUSTE_SALDO
}

enum MovimentacaoCategoria {
  PEDIDO
  SISTEMA
  COMISSAO
  RECOLHE_LOJAS
  BOLETO
  CHEQUE
  AJUSTE_SALDO
  FORNECEDOR
  CUSTO_FIXO
  CUSTO_VARIAVEL
  INVESTIMENTO
  PREJUIZO
}

enum MovimentacaoStatus {
  PREVISTO
  REALIZADO
}

enum TipoDespesa {
  DESPESAS_ADMINISTRATIVAS
  RETIRADA_SOCIOS
  FOLHA_PAGAMENTO
  DESPESAS_DIVERSAS
  GASOLINA
  MATERIAL_ESCRITORIO
  MATERIAL_ESTOQUE_EMBALAGENS
  CUSTOS_OPERACIONAIS
}

enum GiraKidsSubcategoria {
  TAKE_PARCERIA
  PELUCIA_PARCERIA
  OUTROS
}

enum AgendaStatus {
  ATRASADO
  PENDENTE_INTEGRACAO
  PREVISTO
  REALIZADO
}

enum AgendaTipo {
  PAGAR
  RECEBER
}

enum AgendaOrigem {
  DOACAO
  FORNECEDOR
  CF
  CV
  DIVERSOS
  FP
}

enum AgendaTipoPagamento {
  PIX
  TRANSFERENCIA
  CHEQUE
  BOLETO
}

enum PerfilUsuario {
  ADMIN
  FINANCEIRO
  CAIXA
}

enum TemaUsuario {
  LIGHT
  DARK
}

enum StatusSistemaSaas {
  ATIVO
  PAUSADO
  ATRASADO
  ENTREGUE
}

enum StatusMensalidade {
  AGUARDANDO_PAGAMENTO
  EM_ABERTO
  PAGO
  ATRASADO
  PAUSADO
}

enum TipoPlanoSaas {
  FULL
  SMALL
}

enum SaasLancamentoTipo {
  MENSALIDADE
  PAGAMENTO
}

model MachinePayCliente {
  id                 Int                       @id @default(autoincrement())
  nome               String
  documento          String?
  telefone           String?
  email              String?
  diaVencimento      Int                       @default(10) @map("dia_vencimento")
  maquinasProprias   Int                       @default(0) @map("maquinas_proprias")
  maquinasPlano36    Int                       @default(0) @map("maquinas_plano36")
  maquinasOff        Int                       @default(0) @map("maquinas_off")
  maquinasParceria   Int                       @default(0) @map("maquinas_parceria")
  valorMensalidade   Decimal                   @default(40) @map("valor_mensalidade") @db.Decimal(14, 2)
  valorMensalidade36 Decimal                   @default(0) @map("valor_mensalidade36") @db.Decimal(14, 2)
  valorMensalidadeParceria Decimal             @default(0) @map("valor_mensalidade_parceria") @db.Decimal(14, 2)
  valorFixo          Decimal?                  @map("valor_fixo") @db.Decimal(14, 2)
  semMensalidade     Boolean                   @default(false) @map("sem_mensalidade")
  maquinasOnInativas Int                       @default(0) @map("maquinas_on_inativas")
  maquinasOnInativas60 Int                     @default(0) @map("maquinas_on_inativas60")
  status             MachinePayStatusCliente   @default(ATIVO)
  observacoes        String?
  painelUsrId        String?                   @unique @map("painel_usr_id")
  painelRevenda      String?                   @map("painel_revenda")
  painelSincronizadoEm DateTime?               @map("painel_sincronizado_em")
  // Cobranca agrupada: este cliente e cobrado junto com o responsavel.
  agrupadoComId      Int?                      @map("agrupado_com_id")
  agrupadoCom        MachinePayCliente?        @relation("AgrupamentoCobranca", fields: [agrupadoComId], references: [id], onDelete: SetNull)
  agrupados          MachinePayCliente[]       @relation("AgrupamentoCobranca")
  cobrancas          MachinePayCobranca[]
  ajustesMaquinas    MachinePayAjusteMaquina[]
  maquinas           MachinePayMaquina[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([status])
  @@map("machinepay_clientes")
}

model MachinePayMaquina {
  id            Int               @id @default(autoincrement())
  clienteId     Int               @map("cliente_id")
  cliente       MachinePayCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  posId         String            @unique @map("pos_id")
  idPainel      String?           @map("id_painel")
  nome          String?
  ligada        Boolean           @default(true)
  online        Boolean?
  ultimaVendaEm DateTime?         @map("ultima_venda_em")
  inativa       Boolean           @default(false)
  inativa60     Boolean           @default(false) @map("inativa60")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([clienteId])
  @@map("machinepay_maquinas")
}

model MachinePayCobranca {
  id                 Int                      @id @default(autoincrement())
  clienteId          Int                      @map("cliente_id")
  cliente            MachinePayCliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  competencia        String
  vencimento         DateTime
  maquinasProprias   Int                      @default(0) @map("maquinas_proprias")
  maquinasPlano36    Int                      @default(0) @map("maquinas_plano36")
  valorMensalidade   Decimal                  @default(0) @map("valor_mensalidade") @db.Decimal(14, 2)
  valorMensalidade36 Decimal                  @default(0) @map("valor_mensalidade36") @db.Decimal(14, 2)
  maquinasParceria   Int                      @default(0) @map("maquinas_parceria")
  valorMensalidadeParceria Decimal            @default(0) @map("valor_mensalidade_parceria") @db.Decimal(14, 2)
  valor              Decimal                  @db.Decimal(14, 2)
  status             MachinePayStatusCobranca @default(PENDENTE)
  valorPago          Decimal?                 @map("valor_pago") @db.Decimal(14, 2)
  pagoEm             DateTime?                @map("pago_em")
  formaPagamento     String?                  @map("forma_pagamento")
  movimentacaoId     Int?                     @map("movimentacao_id")
  observacoes        String?
  // Detalhe por cliente quando a cobranca junta varios clientes.
  itens              Json?
  sumupCheckoutId    String?                  @unique @map("sumup_checkout_id")
  sumupReferencia    String?                  @map("sumup_referencia")
  pixCopiaCola       String?                  @map("pix_copia_cola")
  pixQrUrl           String?                  @map("pix_qr_url")
  pixGeradoEm        DateTime?                @map("pix_gerado_em")
  pixValidoAte       DateTime?                @map("pix_valido_ate")
  whatsappStatus     String?                  @map("whatsapp_status")
  whatsappEnviadoEm  DateTime?                @map("whatsapp_enviado_em")
  whatsappErro       String?                  @map("whatsapp_erro")
  whatsappNaFilaEm   DateTime?                @map("whatsapp_na_fila_em")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([clienteId, competencia])
  @@index([competencia, status])
  @@map("machinepay_cobrancas")
}

model MachinePayAjusteMaquina {
  id         Int                   @id @default(autoincrement())
  clienteId  Int                   @map("cliente_id")
  cliente    MachinePayCliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo       MachinePayTipoMaquina
  quantidade Int
  motivo     String?
  usuario    String?
  createdAt  DateTime              @default(now())

  @@index([clienteId, createdAt])
  @@map("machinepay_ajustes_maquinas")
}

model MachinePayConfig {
  id            Int      @id @default(1)
  cobrancaAtiva Boolean  @default(false) @map("cobranca_ativa")
  updatedBy     String?  @map("updated_by")
  updatedAt     DateTime @updatedAt

  @@map("machinepay_config")
}

model MachinePaySumupConfig {
  id             Int      @id @default(1)
  ativo          Boolean  @default(false)
  apiKey         String?  @map("api_key")
  merchantCode   String?  @map("merchant_code")
  tipoPix        String   @default("pix") @map("tipo_pix")
  validadeHoras  Int      @default(72) @map("validade_horas")
  contaDestinoId Int?     @map("conta_destino_id")
  urlPublica     String?  @map("url_publica")
  webhookToken   String?  @map("webhook_token")
  updatedBy      String?  @map("updated_by")
  updatedAt      DateTime @updatedAt

  @@map("machinepay_sumup_config")
}

// Contas SumUp do grupo: cada uma com a sua API key, para ver e esquecer as
// maquininhas pareadas na Cloud API daquela conta.
model SumupConta {
  id           Int      @id @default(autoincrement())
  nome         String
  apiKey       String   @map("api_key")
  merchantCode String?  @map("merchant_code")
  nomeConta    String?  @map("nome_conta")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sumup_contas")
}

model MachinePayWhatsappConfig {
  id                Int      @id @default(1)
  ativo             Boolean  @default(false)
  evolutionUrl      String?  @map("evolution_url")
  apiKey            String?  @map("api_key")
  instancia         String?
  intervaloSegundos Int      @default(20) @map("intervalo_segundos")
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @updatedAt

  @@map("machinepay_whatsapp_config")
}

enum MachinePayTipoMaquina {
  PROPRIA
  PLANO36
  OFF
  PARCERIA
}

enum MachinePayStatusCliente {
  ATIVO
  SUSPENSO
  INATIVO
}

enum MachinePayStatusCobranca {
  PENDENTE
  PAGO
  CANCELADO
}
